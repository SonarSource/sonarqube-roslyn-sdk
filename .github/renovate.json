{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config:quality-corelang-squad"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "Microsoft.CodeAnalysis*"
      ],
      "enabled": false
    },
    {
      "description": "Refresh NuGet lockfiles with .NET 10 after dependency updates",
      "matchManagers": [
        "nuget"
      ],
      "skipArtifactsUpdate": true,
      "constraints": {
        "dotnet": "10.0.100"
      },
      "postUpgradeTasks": {
        "executionMode": "update",
        "installTools": {
          "dotnet": {}
        },
        "commands": [
          "dotnet restore PluginGenerator.sln --force-evaluate"
        ],
        "fileFilters": [
          "**/packages.lock.json"
        ]
      }
    }
  ]
}
